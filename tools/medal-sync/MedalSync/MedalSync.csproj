<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>medal-sync</AssemblyName>
    <RootNamespace>MedalSync</RootNamespace>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Single-file publish must carry the native SQLite library. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Medal Sync's own code is precompiled at publish, so each start (every command, launch and status view)
         skips most JIT work: about a third less CPU to start a command. The runtime is already precompiled;
         recompiling it into the exe (the single-file default) adds about 13 MB and starts no faster. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishReadyToRunComposite>false</PublishReadyToRunComposite>
  </PropertyGroup>

  <ItemGroup>
    <!-- 10.0.12 was published 2026-09-08 and bundles a SQLite build with JSONB support. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MedalSync.Tests" />
    <InternalsVisibleTo Include="medal-sync-launch" />
    <InternalsVisibleTo Include="MedalSync.Integration" />
    <InternalsVisibleTo Include="MedalSync.Desktop.Tests" />
  </ItemGroup>

</Project>
