<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>MedalSync.Integration</AssemblyName>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../tools/medal-sync/MedalSync/MedalSync.csproj" />
    <Compile Include="../tools/medal-sync/Fixtures/MedalFixture.cs" Link="Fixtures/MedalFixture.cs" />
    <None Include="../tools/medal-sync/Fixtures/medal-schema-v4.sql" Link="Fixtures/medal-schema-v4.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
